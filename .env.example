# Online multiplayer (Supabase). Copy to .env.local and fill in. Only the PUBLIC values go here.
# NEVER put the service-role key in this project's frontend env: it lives only in the Edge Function.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
